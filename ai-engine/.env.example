# Groq API Key for Multi-Agent Research Assistant
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_hugging_face_api_key
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Upstash Redis URL (Optional: defaults to local Redis)
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379

# Qdrant Vector Store (Optional: defaults to local disk storage at ai-engine/data/qdrant_db)
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here